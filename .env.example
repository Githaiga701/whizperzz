# Safe starting point. These are environment selections, not provider credentials.
PAYMENTS_MODE=sandbox

# Safaricom Daraja: default flow is M-Pesa Express (STK Push).
MPESA_ENV=sandbox
MPESA_FLOW=stk_push
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_SHORTCODE=
MPESA_PASSKEY=
MPESA_CALLBACK_URL=

# Pesapal API 3 sandbox.
PESAPAL_ENV=sandbox
PESAPAL_CONSUMER_KEY=
PESAPAL_CONSUMER_SECRET=
PESAPAL_IPN_URL=
PESAPAL_CALLBACK_URL=

# iPOS Pay: UAT by default; confirm the exact iPOS product with the merchant.
IPOS_ENV=uat
IPOS_API_KEY=
IPOS_SECRET_KEY=

# Unipesa: hosted payment page is the planned default flow.
UNIPESA_ENV=sandbox
UNIPESA_PAYMENT_MODE=hosted_payment_page
UNIPESA_MERCHANT_ID=
UNIPESA_PUBLIC_ID=
UNIPESA_SECRET_KEY=
UNIPESA_CALLBACK_URL=

# Choose a crypto payment processor and supported assets before enabling this.
CRYPTO_ENV=sandbox
CRYPTO_PROVIDER=
CRYPTO_API_KEY=
CRYPTO_WEBHOOK_SECRET=
CRYPTO_CALLBACK_URL=
