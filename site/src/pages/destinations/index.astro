---
import Base from '@/layouts/Base.astro';
import PageHero from '@/components/PageHero.astro';
import FilterBar from '@/components/FilterBar.astro';
import { getDestinations, kindLabel } from '@/lib/content';
import { responsive } from '@/lib/images';

const destinations = await getDestinations();
const nightsLabel = (n: number) => `${n} night${n === 1 ? '' : 's'} or more`;
---

<Base title="Destinations" description="Where we travel in Kenya: the Maasai Mara, Amboseli, Tsavo, the coast, the highlands and the Rift Valley lakes.">
  <PageHero
    title="Kenya, in all its contrast."
    kicker="Where we go"
    intro="Open plains, high country and the Indian Ocean. Find the landscape that feels like yours."
    image={{ src: 'https://images.unsplash.com/photo-1516426122078-c23e76319801?auto=format&fit=crop&w=2000&q=80', alt: 'Elephants on the savannah at sunset' }}
  />

  <section class="section">
    <div class="wrap">
      <FilterBar
        target="#place-rows"
        searchLabel="Search places, wildlife, beaches…"
        noun={['place', 'places']}
        options={[
          { value: 'all', label: 'All places' },
          { value: 'safari', label: 'Safari' },
          { value: 'coast', label: 'Coast' },
          { value: 'highlands', label: 'Highlands' },
          { value: 'lakes', label: 'Lakes' },
        ]}
      />
      <div class="place-rows" id="place-rows">
        {
          destinations.map((d) => (
            <article
              class="place-row"
              data-filter-item
              data-tags={d.data.kind}
              data-search={`${d.data.name} ${d.data.tagline} ${d.data.summary} ${d.data.bestFor} ${d.data.region}`.toLowerCase()}
            >
              <div class="place-row-photo">
                <img {...responsive(d.data.photo.src, '(max-width: 860px) 100vw, 50vw', 1280)} alt={d.data.photo.alt} loading="lazy" decoding="async" width="1200" height="800" />
              </div>
              <div class="place-row-body">
                <h2><a href={`/destinations/${d.id}/`}>{d.data.name}</a></h2>
                <p class="tagline">{d.data.tagline}</p>
                <p>{d.data.summary}</p>
                <dl class="facts">
                  <div><dt>Best for</dt><dd>{d.data.bestFor}</dd></div>
                  <div><dt>Plan for</dt><dd>{nightsLabel(d.data.suggestedNights)}</dd></div>
                  <div><dt>Type</dt><dd>{kindLabel[d.data.kind]}</dd></div>
                  <div><dt>Region</dt><dd>{d.data.region}</dd></div>
                </dl>
              </div>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <section class="section section--deep cta-band">
    <div class="wrap">
      <h2>Want more than one? Most people do.</h2>
      <a class="button" href="/plan/">Sketch a route</a>
    </div>
  </section>
</Base>
