---
import Base from '@/layouts/Base.astro';
import PageHero from '@/components/PageHero.astro';
import FilterBar from '@/components/FilterBar.astro';
import JourneyCard from '@/components/JourneyCard.astro';
import { destinationNames, getPackageStore } from '@/lib/server/packages';

export const prerender = false;

const journeys = await getPackageStore().list({ publishedOnly: true });
const names = await destinationNames();
---

<Base title="Journeys" description="Sample Kenya safari and coast itineraries from Whizperz Tours, each one tailored to your dates and group.">
  <PageHero
    title="Choose your kind of far away."
    intro="Book and pay online in a few minutes, or ask us to change anything first: your dates, your people, your budget."
    image={{ src: 'https://images.unsplash.com/photo-1549366021-9f761d450615?auto=format&fit=crop&w=2000&q=80', alt: 'A giraffe in the savannah' }}
  />

  <section class="section">
    <div class="wrap">
      <FilterBar
        target="#journey-list"
        searchLabel="Search journeys, places, wildlife…"
        noun={['journey', 'journeys']}
        duration
        options={[
          { value: 'all', label: 'All journeys' },
          { value: 'safari', label: 'Safari' },
          { value: 'coast', label: 'Coast' },
          { value: 'family', label: 'Family' },
          { value: 'highlands', label: 'Highlands' },
          { value: 'lakes', label: 'Lakes' },
        ]}
      />
      <div class="journey-grid" id="journey-list" data-reveal-group>
        {journeys.map((j) => <JourneyCard pkg={j} names={names} headingLevel="h2" />)}
      </div>
    </div>
  </section>

  <section class="section section--dark">
    <div class="wrap detail">
      <div>
        <h2>The details, taken care of.</h2>
        <p class="lede">Your quote spells out exactly what’s included, based on your dates, group size and choice of stay.</p>
      </div>
      <ul class="facts" style="list-style:none;padding-left:0;font-size:var(--step-1);border-color:rgba(239,230,210,.2)">
        <li>Private or small-group vehicles with a driver-guide</li>
        <li>Handpicked camps, lodges and beach stays</li>
        <li>Park fees and meals, as quoted</li>
        <li>Internal flights, the SGR train and transfers</li>
        <li>Airport pick-up and drop-off</li>
        <li>Someone to call, any time, while you travel</li>
      </ul>
    </div>
  </section>
</Base>
