---
import '@fontsource/gloock/400.css';
import '@fontsource/hanken-grotesk/400.css';
import '@fontsource/hanken-grotesk/500.css';
import '@fontsource/hanken-grotesk/600.css';
import '@fontsource/hanken-grotesk/700.css';
import '@fontsource/nanum-pen-script/400.css';
import '@/styles/global.css';
import Header from '@/components/Header.astro';
import Footer from '@/components/Footer.astro';
import ContactDock from '@/components/ContactDock.astro';
import { site } from '@/config/site';
import { imageAt, responsive } from '@/lib/images';
// The three fonts the first screen paints with. Preloading them avoids a flash of fallback text.
import displayFont from '@fontsource/gloock/files/gloock-latin-400-normal.woff2?url';
import textFont from '@fontsource/hanken-grotesk/files/hanken-grotesk-latin-400-normal.woff2?url';
import handFont from '@fontsource/nanum-pen-script/files/nanum-pen-script-latin-400-normal.woff2?url';

interface Props {
  title: string;
  description?: string;
  /** Preloads the hero photo for a faster first paint. */
  heroImage?: string;
  /** How wide the hero photo shows (its `sizes`), so the preload picks the same file the page will use. */
  heroSizes?: string;
  /** Keeps private pages (like pay links) out of search engines. */
  noindex?: boolean;
  /** The floating Call / Email / WhatsApp bar. Off where it would cover a form, like pay links. */
  contactDock?: boolean;
}

const { title, description = site.description, heroImage, heroSizes = '100vw', noindex = false, contactDock = true } = Astro.props;
const heroPreload = heroImage ? responsive(heroImage, heroSizes) : undefined;
const ogImage = heroImage ? new URL(imageAt(heroImage, 1280), Astro.site).toString() : undefined;
const fullTitle = title === site.name ? `${site.name} | Kenya safaris & coast` : `${title} | ${site.shortName}`;
const canonical = new URL(Astro.url.pathname, Astro.site);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#2a2017" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    {noindex ? <meta name="robots" content="noindex, nofollow" /> : <link rel="canonical" href={canonical} />}
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    {ogImage && <meta property="og:image" content={ogImage} />}
    <link rel="preconnect" href="https://images.unsplash.com" />
    <link rel="preload" as="font" type="font/woff2" href={displayFont} crossorigin />
    <link rel="preload" as="font" type="font/woff2" href={textFont} crossorigin />
    <link rel="preload" as="font" type="font/woff2" href={handFont} crossorigin />
    {
      heroPreload && (
        <link rel="preload" as="image" href={heroPreload.src} imagesrcset={heroPreload.srcset} imagesizes={heroPreload.sizes} fetchpriority="high" />
      )
    }
    <script is:inline>
      // Full movement by default. When the device asks for reduced motion (iPhone: Settings → Accessibility → Motion),
      // things still fade in gently but nothing slides, zooms or drifts.
      document.documentElement.classList.add(window.matchMedia('(prefers-reduced-motion: reduce)').matches ? 'motion-soft' : 'motion');
    </script>
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <Header />
    <main id="main">
      <slot />
    </main>
    <Footer />
    {contactDock && <ContactDock />}
    <script>
      import '@/scripts/motion';
    </script>
    <script is:inline define:vars={{ langs: site.translateLanguages.join(',') }}>
      window.googleTranslateElementInit = function () {
        // eslint-disable-next-line no-undef
        new google.translate.TranslateElement(
          { pageLanguage: 'en', includedLanguages: langs, layout: google.translate.TranslateElement.InlineLayout.SIMPLE, autoDisplay: false },
          'google_translate_element'
        );
      };
    </script>
    <script is:inline>
      // Google Translate is large and only needed when someone opens the language menu, so it loads once the
      // page has finished and the browser is idle, instead of competing with the photos and fonts.
      (function () {
        var start = function () {
          var s = document.createElement('script');
          s.src = 'https://translate.google.com/translate_a/element.js?cb=googleTranslateElementInit';
          s.async = true;
          document.body.appendChild(s);
        };
        var idle = function () {
          if ('requestIdleCallback' in window) window.requestIdleCallback(start, { timeout: 4000 });
          else window.setTimeout(start, 1500);
        };
        if (document.readyState === 'complete') idle();
        else window.addEventListener('load', idle, { once: true });
      })();
    </script>
  </body>
</html>
