---
import '@fontsource/gloock/400.css';
import '@fontsource/hanken-grotesk/400.css';
import '@fontsource/hanken-grotesk/500.css';
import '@fontsource/hanken-grotesk/600.css';
import '@fontsource/hanken-grotesk/700.css';
import '@/styles/global.css';
import '@/styles/admin.css';
import Logo from '@/components/Logo.astro';
import NetworkBanner from '@/components/NetworkBanner.astro';
import type { Flash } from '@/lib/admin/web';

interface Props {
  title: string;
  /** Which nav item to highlight. */
  active?: 'quotes' | 'new' | 'packages' | 'settings' | 'users';
  flash?: Flash | undefined;
  /** Login and setup pages have no navigation. */
  bare?: boolean;
}

const { title, active, flash, bare = false } = Astro.props;
const user = Astro.locals.admin;
const nav = [
  { href: '/admin/', label: 'Quotes', key: 'quotes' },
  { href: '/admin/quotes/new/', label: 'New quote', key: 'new' },
  { href: '/admin/packages/', label: 'Packages', key: 'packages' },
  { href: '/admin/settings/', label: 'Settings', key: 'settings' },
  { href: '/admin/users/', label: 'Users', key: 'users' },
] as const;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <meta name="theme-color" content="#2a2017" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <title>{title} | Whizperz admin</title>
  </head>
  <body class="admin-body">
    <a class="skip-link" href="#main">Skip to content</a>
    {
      !bare && (
        <header class="admin-top">
          <div class="wrap">
            <a class="brand" href="/admin/">
              <Logo />
              <span class="brand-name notranslate" translate="no">
                whizperz<small>Admin</small>
              </span>
            </a>
            <nav class="admin-nav" aria-label="Admin">
              {nav.map((n) => (
                <a href={n.href} aria-current={active === n.key ? 'page' : undefined}>
                  {n.label}
                </a>
              ))}
              <a href="/" target="_blank" rel="noopener">View site</a>
            </nav>
            {user && (
              <div class="admin-account">
                <span class="admin-user">{user}</span>
                <form method="post" action="/admin/logout/">
                  <button type="submit">Log out</button>
                </form>
              </div>
            )}
          </div>
        </header>
      )
    }
    <main id="main" class:list={[bare ? 'auth-wrap' : 'admin-main wrap']}>
      {flash && <div class:list={['flash', `flash--${flash.kind}`]} role={flash.kind === 'error' ? 'alert' : 'status'}>{flash.text}</div>}
      <slot />
    </main>
    <NetworkBanner note="Nothing you type here is lost." />
    <script>
      import { trackSubmitter } from '@/lib/client/forms';
      import { isOnline } from '@/lib/client/network';
      import { attachValidation } from '@/lib/client/validate';
      import { applyDraft, readDraft, saveDraft, clearDraft } from '@/lib/client/drafts';

      // On a phone the menu is one row that scrolls sideways: bring the current page's tab into view.
      const current = document.querySelector<HTMLElement>('.admin-nav [aria-current="page"]');
      const navRow = current?.parentElement;
      if (current && navRow && navRow.scrollWidth > navRow.clientWidth) {
        navRow.scrollLeft = current.offsetLeft - (navRow.clientWidth - current.offsetWidth) / 2;
      }
      // "Copy" buttons: <button data-copy="#input-id">
      document.querySelectorAll<HTMLButtonElement>('[data-copy]').forEach((btn) => {
        const label = btn.textContent;
        let reset: number | undefined;
        btn.addEventListener('click', async () => {
          const input = document.querySelector<HTMLInputElement>(btn.dataset['copy']!);
          if (!input) return;
          try {
            await navigator.clipboard.writeText(input.value);
            btn.textContent = 'Copied';
          } catch {
            // Clipboard blocked (e.g. not https): select it so Ctrl+C works.
            input.focus();
            input.select();
            btn.textContent = 'Press Ctrl+C';
          }
          // Always back to the original label, even after several quick clicks.
          window.clearTimeout(reset);
          reset = window.setTimeout(() => (btn.textContent = label), 1600);
        });
      });
      // Inline errors on forms marked data-validate. Added before the confirm question below, so a form with
      // mistakes is fixed first and only then asks "Are you sure?".
      document.querySelectorAll<HTMLFormElement>('form[data-validate]').forEach((f) => attachValidation(f));

      // Buttons that need a second click: <button data-confirm="Cancel this quote?">
      // Works out the pressed button itself, because older Safari doesn't say which one it was and the question
      // was being skipped there.
      const forms = new Set([...document.querySelectorAll<HTMLButtonElement>('[data-confirm]')].map((b) => b.form).filter((f) => f !== null));
      forms.forEach((form) => {
        const submitterOf = trackSubmitter(form);
        form.addEventListener('submit', (e) => {
          const btn = submitterOf(e);
          const question = btn?.dataset['confirm'];
          if (question && !window.confirm(question)) e.preventDefault();
        });
      });

      /* ---------- Every admin form: saving state, offline hold, and a draft that survives an expired login ---------- */

      const adminForms = [...document.querySelectorAll<HTMLFormElement>('main form[method="post" i]')];
      const formStatus = (form: HTMLFormElement): HTMLElement => {
        let el = form.querySelector<HTMLElement>(':scope > [data-form-status]');
        if (!el) {
          el = document.createElement('p');
          el.className = 'form-status';
          el.dataset['formStatus'] = '';
          el.setAttribute('role', 'status');
          form.append(el);
        }
        return el;
      };

      // Runs after each form's own submit handlers (validation, "Are you sure?"), so it only acts on real sends.
      document.addEventListener('submit', (e) => {
        const form = e.target as HTMLFormElement;
        if (e.defaultPrevented || !adminForms.includes(form)) return;
        // Kept in this tab only, without passwords, keys or files, in case the login has run out.
        saveDraft(location.pathname, adminForms);
        if (navigator.onLine === false || !isOnline()) {
          e.preventDefault();
          const status = formStatus(form);
          status.dataset['tone'] = 'error';
          status.textContent = 'You’re offline. Nothing was saved, and your changes are still here. Press the button again once you’re connected.';
          return;
        }
        const btn = (e as SubmitEvent).submitter as HTMLButtonElement | null;
        // Switched off a moment later: switching off the pressed button now would drop its value from the form.
        window.setTimeout(() => {
          form.setAttribute('aria-busy', 'true');
          form.querySelectorAll<HTMLButtonElement>('button[type="submit"], button:not([type])').forEach((b) => {
            b.dataset['label'] ??= b.textContent ?? '';
            b.disabled = true;
          });
          if (btn) btn.textContent = btn.dataset['pending'] ?? 'Saving…';
        });
      });

      // Back to this page with the browser's Back button: buttons come back on.
      window.addEventListener('pageshow', (e) => {
        if (!e.persisted) return;
        adminForms.forEach((f) => {
          f.removeAttribute('aria-busy');
          f.querySelectorAll<HTMLButtonElement>('button[data-label]').forEach((b) => {
            b.disabled = false;
            b.textContent = b.dataset['label'] ?? b.textContent;
          });
        });
      });

      // Logged back in after the session ran out: put back what was being typed, once.
      const url = new URL(location.href);
      if (url.searchParams.get('restore') === '1') {
        const draft = readDraft(location.pathname);
        const restored = draft ? applyDraft(draft, adminForms) : 0;
        clearDraft(location.pathname);
        url.searchParams.delete('restore');
        history.replaceState(null, '', url.pathname + url.search + url.hash);
        if (restored > 0) {
          const note = document.createElement('div');
          note.className = 'flash flash--ok';
          note.setAttribute('role', 'status');
          note.dataset['draftRestored'] = '';
          note.textContent = 'You’re logged in again. We put back what you’d typed: check it, then save.';
          document.querySelector('main')?.prepend(note);
        }
      } else {
        // Back on this page normally (e.g. after saving): an old draft must never come back later.
        clearDraft(location.pathname);
      }
    </script>
  </body>
</html>
