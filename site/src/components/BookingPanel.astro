---
import type { TripPackage } from '@/lib/packages/store';
import { kes } from '@/lib/packages/pricing';
import { MPESA_MAX_KES, type PayMethods } from '@/lib/payments/service';

interface Props {
  pkg: TripPackage;
  depositPercent: number;
  dateMin: string;
  dateMax: string;
  methods: PayMethods;
  /** Shillings per US dollar, for iPOS Pay and crypto. */
  usdRate?: number | undefined;
}

const { pkg, depositPercent, dateMin, dateMax, methods, usdRate } = Astro.props;
const p = pkg.pricing;
const hasChildPrice = p.childKes !== null;
const deposits = depositPercent > 0 && depositPercent < 100;
const order = ['mpesa', 'card', 'paystack', 'ipos', 'unipesa', 'crypto'] as const;
const defaultMethod = order.find((m) => methods[m]) ?? 'mpesa';
const config = { pricing: p, depositPercent, mpesaMax: MPESA_MAX_KES, packageId: pkg.id, usdRate: usdRate ?? null };
const choices = [
  { id: 'mpesa', title: 'M-Pesa', note: 'A prompt on your phone' },
  { id: 'card', title: 'Pesapal', note: 'Visa, Mastercard via Pesapal' },
  { id: 'paystack', title: 'Paystack', note: 'Cards, M-Pesa, Apple Pay' },
  { id: 'ipos', title: 'iPOS Pay', note: 'Card, charged in US dollars' },
  { id: 'unipesa', title: 'Unipesa', note: 'Mobile money and cards' },
  { id: 'crypto', title: 'Crypto', note: 'USDT, BTC, ETH and more' },
] as const;
---

<form class="booking" id="booking-form" data-booking data-config={JSON.stringify(config)} novalidate>
  <div data-error-summary hidden></div>
  <div class="booking-head">
    <h2>Book this journey</h2>
    <p class="booking-from">
      <strong>{kes(p.adultKes!)}</strong> per adult{hasChildPrice && <>, {kes(p.childKes!)} per child</>}
    </p>
  </div>

  <fieldset class="booking-step">
    <legend><span class="step-n" aria-hidden="true">1</span> When and who</legend>
    <label class="field">
      Start date
      <input type="date" name="travelDate" min={dateMin} max={dateMax} required data-error-required="Choose the date you’d like to start." />
    </label>
    <div class="booking-counts">
      <div class="counter">
        <span id="adults-label">{hasChildPrice ? 'Adults' : 'Travellers'}</span>
        <div class="counter-ctrl">
          <button type="button" class="icon-btn" data-step="adults:-1" aria-label={`Fewer ${hasChildPrice ? 'adults' : 'travellers'}`}>−</button>
          <input name="adults" type="number" inputmode="numeric" value={String(Math.max(2, p.minGuests) > p.maxGuests ? p.minGuests : Math.max(2, p.minGuests))} min="1" max={p.maxGuests} aria-labelledby="adults-label" />
          <button type="button" class="icon-btn" data-step="adults:1" aria-label={`More ${hasChildPrice ? 'adults' : 'travellers'}`}>+</button>
        </div>
      </div>
      {
        hasChildPrice && (
          <div class="counter">
            <span id="children-label">
              Children <small>under 12</small>
            </span>
            <div class="counter-ctrl">
              <button type="button" class="icon-btn" data-step="children:-1" aria-label="Fewer children">−</button>
              <input name="children" type="number" inputmode="numeric" value="0" min="0" max={p.maxGuests} aria-labelledby="children-label" />
              <button type="button" class="icon-btn" data-step="children:1" aria-label="More children">+</button>
            </div>
          </div>
        )
      }
    </div>
    {!hasChildPrice && <input type="hidden" name="children" value="0" />}
    <p class="hint">{p.minGuests > 1 ? `${p.minGuests} to ${p.maxGuests} travellers.` : `Up to ${p.maxGuests} travellers.`}</p>
  </fieldset>

  {
    deposits && (
      <fieldset class="booking-step">
        <legend><span class="step-n" aria-hidden="true">2</span> How much to pay now</legend>
        <div class="choice-row">
          <label class="choice">
            <input type="radio" name="plan" value="deposit" checked />
            <span>
              <strong>{depositPercent}% deposit</strong>
              <small data-deposit-amount />
            </span>
          </label>
          <label class="choice">
            <input type="radio" name="plan" value="full" />
            <span>
              <strong>Pay in full</strong>
              <small data-full-amount />
            </span>
          </label>
        </div>
        <p class="hint">With a deposit, we send a link for the balance before you travel.</p>
      </fieldset>
    )
  }
  {!deposits && <input type="hidden" name="plan" value="full" />}

  <fieldset class="booking-step">
    <legend><span class="step-n" aria-hidden="true">{deposits ? 3 : 2}</span> How to pay</legend>
    <div class="choice-row">
      {
        choices
          .filter((c) => methods[c.id])
          .map((c) => (
            <label class="choice">
              <input type="radio" name="method" value={c.id} checked={defaultMethod === c.id} />
              <span>
                <strong>{c.title}</strong>
                <small>{c.note}</small>
              </span>
            </label>
          ))
      }
    </div>
  </fieldset>

  <fieldset class="booking-step">
    <legend><span class="step-n" aria-hidden="true">{deposits ? 4 : 3}</span> Your details</legend>
    <label class="field">Full name<input name="name" autocomplete="name" required maxlength="80" data-error-required="Enter your full name." /></label>
    <label class="field">Email <span class="hint">for your receipt</span><input name="email" type="email" autocomplete="email" required data-error-required="Enter your email address so we can send your receipt." /></label>
    <label class="field" data-phone-field>
      <span data-phone-label>M-Pesa number</span>
      <input name="phone" type="tel" inputmode="tel" autocomplete="tel" placeholder="0712 345 678" data-error-required="Enter the Safaricom number to pay from." />
    </label>
  </fieldset>

  <div class="booking-total" aria-live="polite">
    <div class="total-lines" data-lines></div>
    <div class="total-row">
      <span>Pay now</span>
      <strong data-pay-now>—</strong>
    </div>
    <p class="total-note" data-total-note></p>
  </div>

  <p class="form-status" data-status role="status" aria-live="polite"></p>
  <button class="button booking-submit" type="submit" data-submit>Book and pay</button>
  <p class="form-note">Secure payment by Safaricom M-Pesa or Pesapal. We never see your PIN or card details. Free to ask questions first: <a class="link" href="#enquire">send an enquiry</a>.</p>
</form>

<script>
  import { calculatePrice, kes, PriceError, travellersLabel, type PricingRules } from '@/lib/packages/pricing';
  import { onReturn, readJson } from '@/lib/client/forms';
  import { attemptId, request } from '@/lib/client/network';
  import { attachValidation } from '@/lib/client/validate';
  import { normalizeKenyanPhone } from '@/lib/payments/phone';

  interface Config {
    pricing: PricingRules;
    depositPercent: number;
    mpesaMax: number;
    packageId: string;
    usdRate: number | null;
  }

  const form = document.querySelector<HTMLFormElement>('[data-booking]');
  if (form) {
    const cfg = JSON.parse(form.dataset['config']!) as Config;
    const $ = <T extends Element>(sel: string) => form.querySelector<T>(sel);
    const status = $<HTMLElement>('[data-status]')!;
    const payNow = $<HTMLElement>('[data-pay-now]')!;
    const lines = $<HTMLElement>('[data-lines]')!;
    const note = $<HTMLElement>('[data-total-note]')!;
    const submit = $<HTMLButtonElement>('[data-submit]')!;
    const phoneInput = $<HTMLInputElement>('input[name="phone"]')!;
    const phoneLabel = $<HTMLElement>('[data-phone-label]')!;
    const val = (name: string) => (new FormData(form).get(name) as string | null) ?? '';

    // Inline errors. Registered before the submit handler below, so a form with mistakes never gets sent.
    attachValidation(form, {
      phone: (v) => (val('method') === 'mpesa' && !normalizeKenyanPhone(v) ? 'Enter a Safaricom number like 0712 345 678.' : ''),
      name: (v) => (v.length < 2 ? 'Enter your full name.' : ''),
    });

    // One id per set of choices. A retry of the same booking reuses it, so the server can't book it twice;
    // changing anything starts a new one.
    let attempt = attemptId();
    let sending = false;

    const clamp = (input: HTMLInputElement) => {
      const min = Number(input.min || 0);
      const max = Number(input.max || 99);
      const n = Math.round(Number(input.value));
      input.value = String(Number.isFinite(n) ? Math.min(max, Math.max(min, n)) : min);
    };

    function update() {
      setStatus('');
      const method = val('method');
      phoneInput.required = method === 'mpesa';
      phoneLabel.textContent = method === 'mpesa' ? 'M-Pesa number' : 'Phone (optional)';
      const buttons: Record<string, string> = {
        mpesa: 'Book and send M-Pesa prompt',
        card: 'Book and continue to card payment',
        paystack: 'Book and continue to Paystack',
        ipos: 'Book and continue to iPOS Pay',
        unipesa: 'Book and continue to Unipesa',
        crypto: 'Book and continue to crypto payment',
      };
      submit.textContent = buttons[method] ?? 'Book and pay';
      try {
        const price = calculatePrice(cfg.pricing, { adults: Number(val('adults')), children: Number(val('children') || 0), plan: val('plan') === 'deposit' ? 'deposit' : 'full' }, cfg.depositPercent);
        const deposit = Math.ceil((price.totalKes * price.depositPercent) / 100);
        const dep = form!.querySelector('[data-deposit-amount]');
        const full = form!.querySelector('[data-full-amount]');
        if (dep) dep.textContent = kes(deposit);
        if (full) full.textContent = kes(price.totalKes);
        lines.innerHTML = '';
        const row = (label: string, amount: string) => {
          const d = document.createElement('div');
          d.className = 'total-line';
          const a = document.createElement('span');
          a.textContent = label;
          const b = document.createElement('span');
          b.textContent = amount;
          d.append(a, b);
          lines.append(d);
        };
        row(`${price.adults} × ${kes(price.adultKes)}`, kes(price.adults * price.adultKes));
        if (price.children) row(`${price.children} × ${kes(price.childKes)} (children)`, kes(price.children * price.childKes));
        row(`Total for ${travellersLabel(price.adults, price.children)}`, kes(price.totalKes));
        payNow.textContent = kes(price.payNowKes);
        note.textContent = price.plan === 'deposit' ? `Then ${kes(price.balanceKes)} before you travel.` : 'Paid in full. Nothing more to pay.';
        if ((method === 'ipos' || method === 'crypto') && cfg.usdRate) {
          const usd = Math.ceil((price.payNowKes / cfg.usdRate) * 100 - 1e-9) / 100;
          note.textContent += ` Charged as USD ${usd.toFixed(2)}.`;
        }
        const overMpesa = method === 'mpesa' && price.payNowKes > cfg.mpesaMax;
        submit.disabled = overMpesa;
        if (overMpesa) setStatus(`M-Pesa allows up to ${kes(cfg.mpesaMax)} per payment. Choose card${price.plan === 'full' && cfg.depositPercent > 0 ? ' or pay a deposit' : ''}.`, 'error');
      } catch (err) {
        payNow.textContent = '—';
        lines.innerHTML = '';
        note.textContent = '';
        submit.disabled = true;
        if (err instanceof PriceError) setStatus(err.message, 'error');
      }
    }

    form.querySelectorAll<HTMLButtonElement>('[data-step]').forEach((btn) => {
      btn.addEventListener('click', () => {
        const [name, delta] = btn.dataset['step']!.split(':');
        const input = form.querySelector<HTMLInputElement>(`input[name="${name}"]`)!;
        if (sending) return;
        input.value = String(Number(input.value) + Number(delta));
        clamp(input);
        attempt = attemptId();
        update();
      });
    });
    form.addEventListener('input', () => {
      if (sending) return;
      attempt = attemptId();
      update();
    });
    form.addEventListener('change', (e) => {
      if (sending) return;
      attempt = attemptId();
      const t = e.target as HTMLInputElement;
      if (t.type === 'number') clamp(t);
      update();
    });

    function setStatus(message: string, tone: 'info' | 'error' = 'info') {
      status.textContent = message;
      status.dataset['tone'] = tone;
    }

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      if (sending) return;
      sending = true;
      submit.disabled = true;
      form.setAttribute('aria-busy', 'true');
      setStatus(val('method') === 'mpesa' ? 'Saving your booking and sending the M-Pesa prompt…' : 'Saving your booking…');
      const outcome = await request(
        '/api/book',
        {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            packageId: cfg.packageId,
            travelDate: val('travelDate'),
            adults: Number(val('adults')),
            children: Number(val('children') || 0),
            plan: val('plan'),
            method: val('method'),
            name: val('name'),
            email: val('email'),
            phone: val('phone'),
            attemptId: attempt,
          }),
        },
        { timeoutMs: 60_000, onSlow: () => setStatus('Still working on it. Your connection seems slow, so please keep this page open.') },
      );
      if (outcome.kind === 'offline') {
        release('You seem to be offline, so we couldn’t send your booking. Your details are still here: press the button again once you’re connected. You won’t be booked twice.');
        return;
      }
      if (outcome.kind !== 'reply') {
        // The server may have saved it. The same attempt id is sent again, so pressing again is safe.
        release('We didn’t hear back in time, so your booking may already be saved. Press the button again: you won’t be booked twice.');
        return;
      }
      const data = await readJson<{ next?: string }>(outcome.res);
      if (!outcome.res.ok || !data.next) {
        release(data.message ?? 'We couldn’t save your booking. Please try again.');
        return;
      }
      setStatus(val('method') === 'mpesa' ? 'Booked. Taking you to your payment page…' : 'Booked. Taking you to the secure payment page…');
      window.location.assign(data.next);
    });

    /** Switches the button back on (update() decides whether the current choices allow it), then shows `message`. */
    function release(message = '') {
      sending = false;
      form!.removeAttribute('aria-busy');
      update();
      if (message) setStatus(message, 'error');
    }

    // Coming back with the browser's Back button restores the page as it was left (button switched off), so reset it.
    onReturn(() => release());

    update();
  }
</script>
