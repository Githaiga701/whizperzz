---
interface Props {
  title: string;
  kicker?: string | undefined;
  intro?: string | undefined;
  image?: { src: string; alt: string } | undefined;
  crumbs?: { href: string; label: string }[] | undefined;
}
import { responsive } from '@/lib/images';
const { title, kicker, intro, image, crumbs } = Astro.props;
---

<section class:list={['page-hero', !image && 'page-hero--plain']}>
  {image && <img {...responsive(image.src, '100vw')} alt={image.alt} fetchpriority="high" decoding="async" width="1800" height="1000" />}
  <div class="wrap">
    {
      crumbs && (
        <nav class="crumbs" aria-label="Breadcrumb">
          {crumbs.map((c) => (
            <>
              <a href={c.href}>{c.label}</a> /{' '}
            </>
          ))}
          <span aria-current="page">{title}</span>
        </nav>
      )
    }
    {kicker && <span class="kicker">{kicker}</span>}
    <h1>{title}</h1>
    {intro && <p>{intro}</p>}
    <slot />
  </div>
</section>
