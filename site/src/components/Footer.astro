---
import Logo from './Logo.astro';
import Horizon from './Horizon.astro';
import SocialLinks from './SocialLinks.astro';
import { site } from '@/config/site';
import { prettyPhone } from '@/lib/enquiry';
---

<footer class="site-footer">
  <div class="night-sky" aria-hidden="true"><i class="moon"></i><i class="shooting-star"></i></div>
  <Horizon tone="night" class="footer-horizon" />
  <div class="wrap">
    <div class="footer-top">
      <div>
        <a class="brand" href="/" aria-label="Whizperz, home">
          <Logo />
          <span class="brand-name notranslate" translate="no">whizperz<small style="color:var(--on-dark-muted)">Tours & Safaris</small></span>
        </a>
        <p class="footer-motto">{site.motto}</p>
        <SocialLinks class="footer-social" />
      </div>
      <div>
        <h2>Explore</h2>
        <ul>
          <li><a href="/destinations/">Destinations</a></li>
          <li><a href="/packages/">Journeys</a></li>
          <li><a href="/plan/">Sketch a route</a></li>
          <li><a href="/gallery/">Gallery</a></li>
          <li><a href="/about/">Our story</a></li>
        </ul>
      </div>
      <div>
        <h2>Get in touch</h2>
        <ul>
          {site.contact.phones.map((n) => <li><a href={`tel:${n}`}>{prettyPhone(n)}</a></li>)}
          {site.contact.email && <li><a href={`mailto:${site.contact.email}`}>{site.contact.email}</a></li>}
          <li>{site.contact.address}</li>
          {site.contact.postal && <li>{site.contact.postal}</li>}
          <li><a href="/how-to-book/">How to book</a> · <a href="/faq/">FAQs</a></li>
        </ul>
      </div>
    </div>
    <div class="footer-bottom">
      <span>© {new Date().getFullYear()} {site.legalName}, trading as {site.name}</span>
      <a href="/privacy/">Privacy</a>
    </div>
  </div>
</footer>
