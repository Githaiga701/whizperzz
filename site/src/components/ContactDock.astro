---
import { site } from '@/config/site';
import { phoneUrl, whatsappUrl } from '@/lib/enquiry';

const tel = phoneUrl();
const wa = whatsappUrl(site.contact.greeting);
const mail = site.contact.email ? `mailto:${site.contact.email}?subject=${encodeURIComponent('Trip enquiry')}` : null;
---

{(tel || wa || mail) && (
  <nav class="contact-dock notranslate" aria-label="Contact Whizperz">
    {tel && (
      <a href={tel} aria-label="Call Whizperz">
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M6.7 3.8 9.4 3l2 4.5-1.8 1.7a15 15 0 0 0 5.2 5.2l1.7-1.8 4.5 2-.8 2.7a2 2 0 0 1-2.2 1.4C10.5 17.6 6.4 13.5 5.3 6a2 2 0 0 1 1.4-2.2Z" /></svg>
        <span>Call</span>
      </a>
    )}
    {mail && (
      <a href={mail} aria-label="Email Whizperz">
        <svg viewBox="0 0 24 24" aria-hidden="true"><rect x="3.5" y="5" width="17" height="14" rx="1.5" /><path d="m4.5 7 7.5 6 7.5-6" /></svg>
        <span>Email</span>
      </a>
    )}
    {wa && (
      <a class="wa" href={wa} target="_blank" rel="noopener noreferrer" aria-label="WhatsApp Whizperz (opens WhatsApp)">
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M20 11.7a8 8 0 0 1-11.8 7L4 20l1.3-4A8 8 0 1 1 20 11.7Z" /><path d="M9 8.3c.2-.4.4-.4.7-.4h.4l.7 1.7-.7.8a6 6 0 0 0 2.4 2.4l.8-.7 1.7.7v.4c0 .3 0 .5-.4.7-.6.4-1.3.5-2 .3-2.1-.6-4.4-2.9-5-5-.2-.7-.1-1.4.3-2Z" /></svg>
        <span>WhatsApp</span>
      </a>
    )}
  </nav>
)}
