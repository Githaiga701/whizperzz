---
import { socialLinks } from '@/lib/server/social';
import { SOCIAL_ICONS } from '@/lib/social-icons';

/**
 * Buttons for Whizperz's social accounts, shown as each network's own logo. A network with no saved link is faded,
 * marked "coming soon" and isn't clickable, so visitors never land on a broken or wrong page.
 * Links are added in Admin → Settings → Social media.
 */
interface Props {
  tone?: 'dark' | 'light';
  class?: string;
}

const { tone = 'dark', class: className } = Astro.props;
const links = socialLinks();
const noneYet = links.every((l) => !l.url);
const shortName = (label: string) => label.replace(/\s*\(.*\)$/, '');
---

<div class:list={['social-wrap', className]}>
  <ul class:list={['social', `social--${tone}`]} aria-label="Whizperz on social media">
    {
      links.map((l) => (
        <li>
          {l.url ? (
            <a class="social-btn" href={l.url} target="_blank" rel="noopener noreferrer me" data-social={l.key} aria-label={`Whizperz on ${shortName(l.label)} (opens in a new tab)`} title={shortName(l.label)}>
              <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d={SOCIAL_ICONS[l.key]} /></svg>
            </a>
          ) : (
            <span class="social-btn is-soon" data-social={l.key} role="img" aria-label={`${shortName(l.label)}: coming soon`} title={`${shortName(l.label)}: coming soon`}>
              <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d={SOCIAL_ICONS[l.key]} /></svg>
            </span>
          )}
        </li>
      ))
    }
  </ul>
  {noneYet && <p class="social-soon">Our social pages are coming soon.</p>}
</div>
