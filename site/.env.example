# OPTIONAL. Everything here can be set in the admin under Settings instead.
# Use this file (renamed to .env) or your host's dashboard if you prefer keeping keys outside the admin.
# Settings saved in the admin take priority over these.

# Lets you create the first admin account on an online server. Any long secret.
ADMIN_SETUP_KEY=
# Where quotes, settings and users are saved. Must survive redeploys. Back it up.
DATA_DIR=./data

SITE_URL=
PAYMENTS_MODE=sandbox

# M-Pesa (Daraja)
MPESA_ENV=
MPESA_CONSUMER_KEY=peWFEUBGDRv71Gov3unPVbbwGeXqCbBYdyT2XMiIO3oDlCId
MPESA_CONSUMER_SECRET=fGU7MfKJjAO3liK1pyDbChD59JqRbzKK6ocQYYPiCpXOH95wlF9U3yUGJcgOe9YB
MPESA_SHORTCODE=174379
MPESA_PASSKEY=bfb279f9aa9bdbcf158e97dd71a467cd2e0c893059b10f78e6b72ada1ed2c919
MPESA_TILL_NUMBER=322492
MPESA_INITIATOR_NAME=
MPESA_SECURITY_CREDENTIAL=
MPESA_CALLBACK_SECRET=

# Pesapal
PESAPAL_ENV=
PESAPAL_CONSUMER_KEY=
PESAPAL_CONSUMER_SECRET=
PESAPAL_IPN_ID=
PESAPAL_CALLBACK_SECRET=
# Optional: Pesapal's server IPs (comma separated); notifications from elsewhere are ignored
PESAPAL_CALLBACK_IPS=

# Online booking (also in Settings → Online booking)
DEPOSIT_PERCENT=30
BOOKING_LEAD_DAYS=3

# Shillings per US dollar (iPOS Pay and crypto charge in dollars). Also in Settings → Online booking.
USD_KES_RATE=

# iPOS Pay (iPOSpays by Dejavoo). Ecom auth token, or API key + secret key.
IPOS_ENV=
IPOS_TPN=
IPOS_AUTH_TOKEN=
IPOS_API_KEY=
IPOS_SECRET_KEY=
IPOS_CALLBACK_SECRET=

# Unipesa
UNIPESA_MERCHANT_ID=
UNIPESA_SECRET_KEY=
# 12 = Safaricom M-Pesa, 16 = Airtel Money (Kenya), 14 = Unipesa's simulator for testing
UNIPESA_PROVIDER_ID=
# Only if Unipesa gives a separate "merchant public ID"
UNIPESA_PUBLIC_ID=
# Unipesa's status address; write {public_id} or {merchant_id} where your ID goes
UNIPESA_STATUS_URL=
# Unipesa's server IPs (comma separated, IPv4 ranges allowed); results from anywhere else are ignored
UNIPESA_CALLBACK_IPS=
UNIPESA_COUNTRY=KE
UNIPESA_CURRENCY=KES
UNIPESA_PAY_TYPE=
UNIPESA_CALLBACK_SECRET=

# Crypto (NOWPayments)
NOWPAYMENTS_ENV=
NOWPAYMENTS_API_KEY=
NOWPAYMENTS_IPN_SECRET=
NOWPAYMENTS_CALLBACK_SECRET=

# Email
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=
NOTIFY_EMAIL=

# For scripts only (npm run quote / the admin API without logging in)
ADMIN_TOKEN=
