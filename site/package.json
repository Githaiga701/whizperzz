{
  "name": "whizperz-site",
  "type": "module",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "astro dev",
    "build": "astro check && astro build",
    "start": "node --env-file-if-exists=.env dist/server/entry.mjs",
    "preview": "astro preview",
    "check": "astro check",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "astro build && playwright test",
    "test:all": "npm run check && npm test && npm run test:e2e",
    "quote": "tsx --env-file-if-exists=.env scripts/create-quote.ts",
    "pesapal:register-ipn": "tsx --env-file-if-exists=.env scripts/register-pesapal-ipn.ts",
    "build:site": "astro build"
  },
  "dependencies": {
    "@astrojs/node": "^11.1.9",
    "@astrojs/vercel": "^11.0.16",
    "@fontsource/gloock": "^5.3.0",
    "@fontsource/hanken-grotesk": "^5.3.0",
    "@fontsource/nanum-pen-script": "^5.3.0",
    "astro": "^7.4.2",
    "nodemailer": "^10.0.16"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.63.0",
    "@types/mailparser": "^3.9.0",
    "@types/node": "^22.20.5",
    "@types/smtp-server": "^3.5.13",
    "mailparser": "^3.12.4",
    "smtp-server": "^3.21.1",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "vitest": "^5.0.5"
  },
  "engines": {
    "node": ">=22.23.4"
  }
}
